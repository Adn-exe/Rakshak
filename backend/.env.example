# Google Gemini API Key (required for image relevance and AI structural assessment)
# Replace with your actual Gemini API Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Blur detection threshold (Laplacian variance)
# Lower = more permissive, Higher = stricter
BLUR_THRESHOLD=100

# Borderline blur threshold (between good and blurry)
BLUR_BORDERLINE_THRESHOLD=50

# Server config
HOST=0.0.0.0
PORT=8000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
